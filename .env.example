# ============================================================
# GELAKRAFT · INGURUNE-ALDAGAIAK / VARIABLES DE ENTORNO
# ============================================================
# Para usar en local:
#   1. Copia este archivo a `.env.local`
#   2. Rellena los valores con los de tu proyecto en Supabase
#      (los encuentras en: Supabase > Settings > API)
#
# Para producción (Vercel):
#   Settings > Environment Variables → añadir los mismos valores
# ============================================================

# URL pública de tu proyecto en Supabase
# Ej: https://xxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Clave pública "anon" — segura para usar en el navegador
# (RLS protege los datos a nivel de base de datos)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
