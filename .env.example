# ============================================================
# GELAKRAFT · INGURUNE-ALDAGAIAK / VARIABLES DE ENTORNO
# ============================================================
# Para usar en local:
#   1. Copia este archivo a `.env.local`
#   2. Rellena los valores con los de tu proyecto en Supabase
#      (los encuentras en: Supabase > Settings > API)
#
# Para producción (Vercel):
#   Settings > Environment Variables → añadir los mismos valores
# ============================================================

# URL pública de tu proyecto en Supabase
# Ej: https://xxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Clave pública "publishable" — segura para usar en el navegador
# (RLS protege los datos a nivel de base de datos)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secreto para cifrar las cookies de sesión de los ALUMNOS.
# Debe tener al menos 32 caracteres aleatorios.
# Generar uno con: openssl rand -base64 32
# O usar este sitio: https://1password.com/password-generator/
# ⚠️ NUNCA empezar por NEXT_PUBLIC_ — esto es un secreto del servidor.
STUDENT_SESSION_SECRET=
